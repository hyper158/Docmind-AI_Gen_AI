# Root gitignore
node_modules/
dist/
.DS_Store

# Backend
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/.pytest_cache/
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/indexes/*
!backend/storage/indexes/.gitkeep
backend/storage/metadata/*.db
backend/storage/metadata/*.sqlite
!backend/storage/metadata/.gitkeep
backend/.env

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# Generated summaries
backend/storage/summaries/
