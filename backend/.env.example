# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# OpenRouter / LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_TIMEOUT_SECONDS=30

# Embedding & RAG Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
RELEVANCE_SCORE_THRESHOLD=0.10

# Storage Configuration
MAX_FILE_SIZE_MB=50

# Hierarchical Summarization Configuration
SUMMARIZATION_CONCURRENCY_LIMIT=3
SUMMARIZATION_PAGE_CHUNK_SIZE=3000
SUMMARIZATION_PAGE_CHUNK_OVERLAP=300
SUMMARIZATION_MAX_OUTPUT_TOKENS=4096
SUMMARIZATION_TIMEOUT_SECONDS=60
SUMMARIZATION_MAX_RETRIES=3
SUMMARIZATION_RETRY_BACKOFF=2.0
